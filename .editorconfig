# https://editorconfig.org — Biome enforces the same for TS/JS/JSON (biome.json).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{sh,bash}]
indent_size = 2

[*.{container,network,volume,pod,kube,service,timer}]
indent_style = space

[Caddyfile]
indent_style = tab
