# Provisia API (Fastify). Build from the repo root:
#   podman build -f deploy/containerfiles/Containerfile.api -t provisia-api:dev .
#
# Stages: deps (full install) -> build (tsup bundle) -> prune (production node_modules) -> runtime.
# Workspace packages are inlined into apps/api/dist/index.js by tsup; only third-party packages
# from node_modules are needed at runtime (see docs/FOUNDATION.md "Build strategy").
ARG NODE_IMAGE=docker.io/library/node:22-bookworm-slim

# ---------------------------------------------------------------------------------------------
FROM ${NODE_IMAGE} AS base
ARG PNPM_VERSION=12.11.2
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    CI=true \
    TURBO_TELEMETRY_DISABLED=1 \
    NEXT_TELEMETRY_DISABLED=1 \
    npm_config_update_notifier=false
RUN npm install -g "pnpm@${PNPM_VERSION}" && npm cache clean --force
WORKDIR /app

# ---------------------------------------------------------------------------------------------
FROM base AS deps
# python3/make/g++ are only a fallback for native modules without a prebuilt binary (argon2 ships prebuilds).
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 make g++ ca-certificates \
 && rm -rf /var/lib/apt/lists/*
COPY . .
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm config set store-dir /pnpm/store \
 && pnpm install --frozen-lockfile

# ---------------------------------------------------------------------------------------------
FROM deps AS build
RUN pnpm --filter @provisia/api... run build

# ---------------------------------------------------------------------------------------------
FROM build AS prune
# Production dependencies of the selected app and its workspace dependencies only. The hoisted linker
# writes a flat, symlink-free /app/node_modules (like npm), which is what the tsup bundle resolves against.
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    rm -rf node_modules apps/*/node_modules packages/*/node_modules \
 && pnpm install --frozen-lockfile --prod --node-linker=hoisted --filter "@provisia/api..." \
 && pnpm store prune >/dev/null 2>&1 || true

# ---------------------------------------------------------------------------------------------
FROM ${NODE_IMAGE} AS runtime
ARG VERSION=dev
ARG REVISION=unknown
ARG CREATED=1970-01-01T00:00:00Z
LABEL org.opencontainers.image.title="provisia-api" \
      org.opencontainers.image.description="Provisia HTTP API (Fastify)" \
      org.opencontainers.image.source="https://codeberg.org/provisia/provisia" \
      org.opencontainers.image.licenses="AGPL-3.0-only" \
      org.opencontainers.image.vendor="Provisia" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.created="${CREATED}" \
      io.containers.autoupdate="registry"
ENV NODE_ENV=production \
    PORT=3001 \
    HOST=0.0.0.0 \
    STORAGE_PATH=/data/storage
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates tini \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --system --gid 10001 provisia \
 && useradd --system --uid 10001 --gid provisia --home /app --shell /usr/sbin/nologin provisia \
 && mkdir -p /app /data/storage \
 && chown -R provisia:provisia /app /data
WORKDIR /app
COPY --from=prune --chown=provisia:provisia /app/package.json /app/package.json
COPY --from=prune --chown=provisia:provisia /app/node_modules /app/node_modules
COPY --from=prune --chown=provisia:provisia /app/apps/api/package.json /app/apps/api/package.json
COPY --from=prune --chown=provisia:provisia /app/apps/api/node_modules /app/apps/api/node_modules
COPY --from=build --chown=provisia:provisia /app/apps/api/dist /app/apps/api/dist
USER provisia
EXPOSE 3001
VOLUME ["/data/storage"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3001)+'/api/v1/public/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "apps/api/dist/index.js"]
