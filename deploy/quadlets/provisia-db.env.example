# Environment for the provisia-postgres container only. Install path: ~/.config/provisia/provisia-db.env
# (rootless) or /etc/provisia/provisia-db.env (rootful). chmod 600.
# POSTGRES_PASSWORD must match the password inside DATABASE_URL in provisia.env.
POSTGRES_USER=provisia
POSTGRES_PASSWORD=replace-with-db-password
POSTGRES_DB=provisia
