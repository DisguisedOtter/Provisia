# Environment for the provisia-valkey container only. Install path: ~/.config/provisia/provisia-valkey.env
# (rootless) or /etc/provisia/provisia-valkey.env (rootful). chmod 600.
# Must match the password inside REDIS_URL in provisia.env:  redis://:VALKEY_PASSWORD@provisia-valkey:6379
# Generate:  openssl rand -hex 24
VALKEY_PASSWORD=replace-with-valkey-password
