# Environment for the provisia-web (Next.js) container only. Install path: ~/.config/provisia/provisia-web.env
# (rootless) or /etc/provisia/provisia-web.env (rootful). chmod 600. Public URLs only: the web container
# never gets APP_KEY, SESSION_SECRET or DATABASE_URL (a server-side rendering bug cannot leak them).
NODE_ENV=production
LOG_LEVEL=info
# Public URLs; behind the bundled proxy both are https://PROVISIA_DOMAIN.
APP_URL=https://billing.example.com
WEB_URL=https://billing.example.com
# Where the browser reaches the API. Same as APP_URL behind the bundled proxy.
NEXT_PUBLIC_API_URL=https://billing.example.com
# Server-side rendering talks to the API over the internal network instead of going out through the proxy.
INTERNAL_API_URL=http://provisia-api:3001
