# Provisia production environment. Install path: ~/.config/provisia/provisia.env (rootless)
# or /etc/provisia/provisia.env (rootful). chmod 600. Every variable is documented in docs/CONFIGURATION.md.
# Lines are KEY=VALUE without shell expansion (systemd EnvironmentFile syntax): no ${VAR}, quote values with spaces.

# ---- Public identity ------------------------------------------------------------------------
# Hostname the installation is served on. Caddy obtains a certificate for it automatically.
PROVISIA_DOMAIN=billing.example.com
# Contact address for the ACME (Let's Encrypt) account, expiry warnings go here.
PROVISIA_ACME_EMAIL=admin@example.com
# Public URLs. Behind the bundled proxy both are https://PROVISIA_DOMAIN (API is served under /api).
APP_URL=https://billing.example.com
WEB_URL=https://billing.example.com
# Where the browser reaches the API. Same as APP_URL behind the bundled proxy.
NEXT_PUBLIC_API_URL=https://billing.example.com

# ---- Secrets --------------------------------------------------------------------------------
# 32 random bytes, hex (64 chars). Encrypts gateway/registrar/server credentials at rest (AES-256-GCM).
# Generate:  openssl rand -hex 32
# Losing this key makes every stored credential unreadable; back it up with the database.
APP_KEY=replace-with-openssl-rand-hex-32
# Signs session cookies. At least 32 characters. Generate:  openssl rand -hex 32
SESSION_SECRET=replace-with-openssl-rand-hex-32

# ---- Database / queue (container-internal hostnames on the provisia network) ----------------
# Password must match POSTGRES_PASSWORD in provisia-db.env.
DATABASE_URL=postgres://provisia:replace-with-db-password@provisia-postgres:5432/provisia
REDIS_URL=redis://provisia-valkey:6379

# ---- Runtime --------------------------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
# Session lifetime in days.
SESSION_TTL_DAYS=30
# Parallel jobs per worker process.
WORKER_CONCURRENCY=5
# Invoice PDFs and uploads (the provisia-storage volume is mounted here in api and worker).
STORAGE_PATH=/data/storage

# ---- Email ----------------------------------------------------------------------------------
# smtp://user:pass@host:587 (STARTTLS) or smtps://user:pass@host:465 (implicit TLS). URL-encode special chars.
SMTP_URL=smtp://user:password@smtp.example.com:587
MAIL_FROM="Provisia <noreply@example.com>"

# ---- First start ----------------------------------------------------------------------------
# true: the migrate job also seeds the admin user, EU tax rules and a demo product. Set back to false
# after the first start (the seed is idempotent, but the password below should not stay on disk).
MIGRATE_SEED=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
